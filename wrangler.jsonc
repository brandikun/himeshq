// LEARN: wrangler.jsonc tells Cloudflare how to deploy. Here: a Worker with no code, just static assets served from dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "himeshq",
  // Placeholder: set this to the day of the first real deploy.
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
  },
}
